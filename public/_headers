# Cloudflare Pages reads this file directly. Later, more specific rules win.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  X-Frame-Options: DENY
  Cross-Origin-Opener-Policy: same-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'none'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: blob:; connect-src 'self' blob:; worker-src 'self' blob:; frame-ancestors 'none'; base-uri 'none'; form-action 'none'

# HTML is small and changes every deploy; never let a stale page pin an old bundle.
/
  Cache-Control: public, max-age=0, must-revalidate
/*/
  Cache-Control: public, max-age=0, must-revalidate

# Versioned with the deploy and safe to pin.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
/vendor/*
  Cache-Control: public, max-age=31536000, immutable

# The OCR language models.
#
# These are already gzip streams that tesseract.js fetches and inflates itself. If the CDN
# applied its own Content-Encoding on top, the browser would transparently decode one layer and
# hand tesseract raw traineddata, which it would then fail to inflate. Declaring them
# application/gzip keeps them out of the compressible set; no Content-Encoding is set here.
/vendor/tessdata/*
  Content-Type: application/gzip
  Cache-Control: public, max-age=31536000, immutable
