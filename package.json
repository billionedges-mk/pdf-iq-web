{
  "name": "pdf-iq-web",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "description": "pdf-iq.com - client-side PDF tools. Files never leave the device.",
  "type": "module",
  "scripts": {
    "prebuild": "node tools/licenses.mjs",
    "build": "node tools/build.mjs",
    "dev": "node tools/build.mjs --watch --serve",
    "licenses": "node tools/licenses.mjs",
    "audit": "node tools/audit.mjs",
    "verify:pdflib": "node tools/verify-pdflib-errors.mjs",
    "contrast": "node tools/contrast.mjs",
    "selftest": "node tools/selftest.mjs",
    "typecheck": "tsc --noEmit",
    "verify:interest": "node tools/verify-interest.mjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/public-sans": "^5.3.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.3.289",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
